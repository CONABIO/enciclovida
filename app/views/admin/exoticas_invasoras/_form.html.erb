<%= form_for([:admin, @exotica], html: { multipart: true }) do |f| %>

  <div class="form-group">
    <%= text_field_tag :nombre_cientifico, @exotica.especie&.nombre_cientifico, id: "exotica_nombre_cientifico", class: "form-control", placeholder: "Buscar especie" %>
    <ul id="soulmate-exoticas" class="bg-light shadow-sm"></ul>
    <%= f.hidden_field :especie_id %>
  </div>
  <% @catalogos.each do |tipo, catalogos| %>
    <%= render "catalogos_checkboxes", titulo: tipo.humanize, tipo: tipo, catalogos: catalogos, exotica: @exotica %>
  <% end %>
  <div class="form-group mt-3">
    <%= f.label :observaciones %>
    <%= f.text_area :observaciones, rows: 4, class: "form-control" %>
  </div>
  <%= render "documentos", f: f %>
  <%= link_to "Cancelar", admin_exoticas_invasoras_path, class: "btn btn-secondary" %>
  <%= f.submit "Guardar", class: "btn btn-success" %>
<% end %>