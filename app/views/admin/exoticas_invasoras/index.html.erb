<h1>Especies Exóticas Invasoras</h1>

<p>
  <%= link_to "Nueva especie", new_admin_exotica_invasora_path, class: "btn btn-primary" %>
  <%= link_to "Administrar catálogos", admin_exoticas_catalogos_path, class: "btn btn-secondary" %>
</p>

<table class="table table-striped table-hover table-bordered">
  <thead>
    <tr>
      <th>Foto</th>
      <th>Nombre científico</th>
      <% @catalogos.each do |tipo, opciones| %>
        <th>
          <%= tipo.humanize %>
        </th>
      <% end %>
      <th>Créditos</th>
      <th>Observaciones</th>
      <th>Análisis de riesgo</th>
      <th width="180">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @exoticas.each do |e| %>
      <tr>
        <td class="text-center">
          <% if e.especie&.adicional&.foto_principal.present? %>
            <%= image_tag e.especie.adicional.foto_principal, class: "img rounded", style: "width: 8em" %>
          <% end %>
        </td>
        <td>
          <%= e.especie.nombre_cientifico %>
        </td>
        <% @catalogos.each do |tipo, opciones| %>
          <td>
            <% e.catalogos_por_tipo(tipo).each do |catalogo| %>
              <span class="badge badge-info">
                <%= catalogo.nombre %>
              </span>
              <br>
            <% end %>
          </td>
        <% end %>
        <td>
          <%= e.creditos_fotos %>
        </td>
        <td>
          <%= truncate(e.observaciones, length: 60) %>
        </td>
        <td>
          <% e.documentos.each do |documento| %>
            <%= link_to documento.tipo_documento.nombre, documento.ruta, target: "_blank", rel: "noopener", class: "badge badge-info" %>
          <% end %>
        </td>
        <td>
          <%= link_to "Editar",edit_admin_exotica_invasora_path(e), class: "btn btn-sm btn-primary" %>
          <%= link_to "Eliminar", admin_exotica_invasora_path(e), method: :delete, data: { confirm: "¿Está seguro de eliminar esta especie?" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @paginas > 1 %>
  <nav aria-label="Paginación">
    <ul class="pagination justify-content-center">

      <% if @pagina > 1 %>
        <li class="page-item">
          <%= link_to "Anterior",
              admin_exoticas_invasoras_path(pagina: @pagina - 1),
              class: "page-link" %>
        </li>
      <% else %>
        <li class="page-item disabled">
          <span class="page-link">Anterior</span>
        </li>
      <% end %>

      <% (1..@paginas).each do |pagina| %>
        <li class="page-item <%= 'active' if pagina == @pagina %>">
          <%= link_to pagina,
              admin_exoticas_invasoras_path(pagina: pagina),
              class: "page-link" %>
        </li>
      <% end %>

      <% if @pagina < @paginas %>
        <li class="page-item">
          <%= link_to "Siguiente",
              admin_exoticas_invasoras_path(pagina: @pagina + 1),
              class: "page-link" %>
        </li>
      <% else %>
        <li class="page-item disabled">
          <span class="page-link">Siguiente</span>
        </li>
      <% end %>

    </ul>
  </nav>
<% end %>