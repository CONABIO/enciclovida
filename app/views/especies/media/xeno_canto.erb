
<% mensaje = @cantos.first[:msg] if @cantos.one? %>

<% if mensaje.present? %>
  <div class="alert alert-info text-center" role="alert">
    <%= mensaje %>
  </div>
<% elsif @cantos.present? %>
  <div class="d-flex flex-column flex-md-row mb-3 h1">
    <% icono = {
      "photo" => "camera",
      "video" => "film",
      "audio" => "volume-up"
    } %>

    <i class="fa fa-<%= icono[type] || 'volume-up' %> btn-title"
       title="<%= type.to_s.titleize %>"></i>

    <span class="ml-4">Xeno-canto</span>
  </div>

  <div class="paginado-media d-flex align-items-center">
    <button type="button"
            class="btn rounded-circle btn-light position-absolute">
      <i class="fa fa-chevron-left"></i>
    </button>

    <button type="button"
            class="btn rounded-circle btn-light position-absolute">
      <i class="fa fa-chevron-right"></i>
    </button>

    <% @cantos.each do |canto| %>
      <%= imprime_canto(canto) %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info text-center" role="alert">
    No se encontraron grabaciones para esta especie.
  </div>
<% end %>
